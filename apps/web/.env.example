# --- Sitio ---
# Origen absoluto para canonical, sitemap, JSON-LD y og:url. Sin ella, cae al
# valor fijo de @site/config/site.ts (https://pavivasa.com). En un deploy de
# Vercel con VERCEL_ENV=production, check-env AVISA por consola si falta
# (no rompe el build hoy — ver packages/config/scripts/check-env.ts).
NEXT_PUBLIC_SITE_URL=https://pavivasa.com

# NAP: por defecto se usan los datos publicados en @site/content
# (packages/content/src/data/business.ts, vía lib/config/nap.ts).
# Rellenar solo para sobreescribirlos.
NEXT_PUBLIC_TELEFONO=
# WhatsApp no existe aún (pendiente del cliente): vacío se muestra como DatoPendiente.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_DIRECCION=

# --- Formulario de presupuesto ---
# API key de Resend para enviar el email del lead. Server-only, nunca al bundle cliente.
RESEND_API_KEY=
# Destino del email del formulario. OJO: no es un secreto puro — si se
# define, también sustituye el email público del NAP (footer, /presupuesto,
# páginas legales y el JSON-LD de LocalBusiness). Ver lib/config/nap.ts y
# scripts/verify/known-issues.json ("secrets"/"name-leak").
EMAIL_DESTINO=gabriel.pavivasa@gmail.com
# Bot y chat de Telegram que reciben el aviso de lead. Server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Analítica y publicidad (nada se carga sin consentimiento) ---
# ID de GA4/Google tag, formato "G-XXXXXXXXXX" (o legacy "UA-…"/"GT-…"). Sin valor, no se carga GA4.
NEXT_PUBLIC_GA_ID=
# ID de conversión de Google Ads, formato "AW-XXXXXXXXX".
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Label de conversión de Google Ads para el lead del formulario.
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# ID numérico del Meta Pixel.
NEXT_PUBLIC_META_PIXEL_ID=
# Token de Meta Conversions API (envío server-side). Server-only, vía
# @site/tracking/server + @site/config/server.
META_CAPI_ACCESS_TOKEN=

# --- La pone Vercel, no configurar a mano ---
# VERCEL_ENV=production|preview|development — la lee check-env para decidir
# si avisar por NEXT_PUBLIC_SITE_URL ausente en producción.
